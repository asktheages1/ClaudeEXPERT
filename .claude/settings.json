{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {"matcher": "startup|resume|compact",
       "hooks": [{"type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh", "timeout": 60}]}
    ],
    "PostToolUse": [
      {"matcher": "Bash|Edit|Write",
       "hooks": [{"type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/post-tool.sh", "timeout": 20}]}
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/stop.sh", "timeout": 60}]}
    ]
  }
}
